{
	# The admin API is not needed outside the container.
	admin 127.0.0.1:2019
	# SSL is terminated by the upstream reverse proxy; Caddy serves plain HTTP.
	auto_https off
	# Serve HTTP/2 (h2c) on the plain-HTTP listener so gRPC clients can reach
	# the merged port without an HTTP/1.1 upgrade round-trip.
	servers {
		protocols h1 h2c
	}
}

# One public HTTP port for both the panel (8080) and the agent control
# endpoint (9443). Caddy routes by HTTP/2 path:
#   /nekopass.v1.Control/*  -> h2c backend on 9443
#   everything else         -> panel HTTP on 8080
:80 {
	@agent path /nekopass.v1.Control/*
	handle @agent {
		reverse_proxy {$NEKOPASS_AGENT_UPSTREAM:127.0.0.1:9443} {
			transport http {
				versions h2c
			}
		}
	}

	handle {
		reverse_proxy {$NEKOPASS_UPSTREAM:127.0.0.1:8080} {
			# Honour X-Forwarded-Proto from the upstream reverse proxy.
			trusted_proxies 0.0.0.0/0
		}
	}
}
