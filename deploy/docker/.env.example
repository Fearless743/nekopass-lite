# Copy to .env and adjust before running docker compose.
# Public HTTPS hostname; must resolve to this server and have port 443/tcp free.
NEKOPASS_DOMAIN=panel.example.com
# The single public port used by both the panel and node connections.
NEKOPASS_PUBLIC_PORT=443
# Caddy runs inside the panel container and reaches it over loopback.
NEKOPASS_TRUSTED_PROXIES=127.0.0.0/8
# Use letters, digits, '-' and '_' so the value stays a valid PostgreSQL URI.
POSTGRES_PASSWORD=change-me
# Optional: pin the image tag and the initially created administrator.
NEKOPASS_IMAGE=ghcr.io/fearless743/nekopass-lite:latest
NEKOPASS_VERSION=latest
NEKOPASS_ADMIN_USERNAME=admin
# When empty a random password is generated and printed once in the logs.
# NEKOPASS_ADMIN_PASSWORD=
